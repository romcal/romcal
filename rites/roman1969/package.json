{
  "name": "@internal/rite-roman1969",
  "version": "0.0.0",
  "description": "Liturgical calendar for the Roman Rite according to the 1969 reform",
  "license": "MIT",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/esm/romcal.js",
    "require": "./dist/cjs/romcal.js"
  },
  "main": "dist/cjs/romcal.js",
  "module": "dist/esm/romcal.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "romcal-build build --rite roman1969",
    "clean": "rimraf coverage dist tmp",
    "data:checks": "romcal-build check --rite roman1969",
    "doc": "romcal-build doc --rite roman1969",
    "docs:check-links": "node ../../packages/builder/src/commands/docs/check-broken-links.mjs ../../docs",
    "docs:sort-glossary": "node ../../packages/builder/src/commands/docs/sort-glossary.mjs",
    "test": "TZ=UTC jest --coverage",
    "test:snapshot:update": "TZ=UTC jest -u",
    "test:watch": "TZ=UTC jest --watch",
    "test:without-coverage": "TZ=UTC jest"
  },
  "dependencies": {
    "@internal/easter": "file:../../packages/easter",
    "@internal/generator": "file:../../packages/generator",
    "@internal/lunar-new-year": "file:../../packages/lunar-new-year",
    "@internal/proper-of-time": "file:../../packages/proper-of-time",
    "i18next": "^26.4.0",
    "ts-deepmerge": "^8.0.0"
  },
  "devDependencies": {
    "@internal/builder": "file:../../packages/builder",
    "@types/jest": "^30.0.0",
    "@types/node": "~26.2.0",
    "esbuild-jest": "~0.5.0"
  }
}
