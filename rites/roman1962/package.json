{
  "name": "@internal/rite-roman1962",
  "version": "0.0.0",
  "private": true,
  "description": "Liturgical calendar for the Roman Rite according to the 1962 Missale Romanum (Rubricae 1960)",
  "license": "MIT",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/esm/romcal.js",
    "require": "./dist/cjs/romcal.js"
  },
  "main": "dist/cjs/romcal.js",
  "module": "dist/esm/romcal.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "tsx build/build.ts",
    "clean": "rimraf coverage dist tmp",
    "import:do": "tsx build/import-divinum-officium/index.ts",
    "test": "TZ=UTC jest --coverage",
    "test:watch": "TZ=UTC jest --watch",
    "test:without-coverage": "TZ=UTC jest"
  },
  "dependencies": {
    "@internal/rite-roman1969": "*",
    "i18next": "^26.0.3"
  },
  "devDependencies": {
    "@internal/config": "file:../../packages/config",
    "@types/jest": "^30.0.0",
    "@types/node": "~25.5.2",
    "chalk": "^4.1.2",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "~0.28.0",
    "esbuild-jest": "~0.5.0",
    "jest-extended": "^6.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "~5.9.3"
  }
}
